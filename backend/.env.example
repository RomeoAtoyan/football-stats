# PitchTrack AI — Backend Environment Variables
# Copy this file to .env and fill in your values.

# ── SAM 3 Model ──────────────────────────────────────────────────────────────
# Path where sam3.pt is stored (or will be downloaded to).
# Defaults to <backend_dir>/sam3.pt if not set.
SAM3_MODEL_PATH=./sam3.pt

# HuggingFace token for automatic sam3.pt download from facebook/sam3.
# Required only if sam3.pt is not already present at SAM3_MODEL_PATH.
HF_TOKEN=your_huggingface_token_here

# Device to run SAM 3 inference on: "cuda" (GPU) or "cpu".
# GPU strongly recommended — SAM 3 is a large foundation model.
SAM3_DEVICE=cuda
